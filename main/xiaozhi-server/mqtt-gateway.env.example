# ============================================================
# MQTT gateway environment (.env consumed by docker-compose)
# Copy to `mqtt-gateway.env` and fill in the two secret values.
# ============================================================

# LAN-reachable address devices use to reach the gateway (MQTT + UDP).
PUBLIC_IP=192.168.0.195

# Ports the gateway listens on (published by docker-compose).
MQTT_PORT=1883
UDP_PORT=8884
API_PORT=8007

# MQTT connection-password signing key.
# Requirements (enforced by the gateway at startup):
#   - >= 8 characters
#   - at least one uppercase AND one lowercase letter
#   - must NOT contain: test, 1234, admin, password, qwerty, xiaozhi
# Must match the console system value:  Params Management -> server.mqtt_signature_key
# e.g. MQTT_SIGNATURE_KEY=G<openssl rand -hex 24>L
MQTT_SIGNATURE_KEY=

# Secret the gateway uses to authenticate its websocket bridge to the server.
# Must equal the Python server's secret (DB sys_params server.secret ==
# /opt/xiaozhi-server/data/.config.yaml manager-api.secret).
SERVER_SECRET=
